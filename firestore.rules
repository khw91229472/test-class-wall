rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 교사(Teacher) 판별 함수: 교사 UID 목록에 포함되어 있는지 확인
    function isTeacher() {
      return request.auth != null && (
        request.auth.uid in [
          '5KZWUvaJsGVhfd7Gk9HIJTsIwtY2' // 교사 UID (추가 교사 UID는 여기에 등록)
        ]
      );
    }

    // 학생(Student) 판별 함수: 로그인된 일반 사용자
    function isStudent() {
      return request.auth != null && !isTeacher();
    }

    match /memos/{memoId} {
      // 1. 읽기: 담벼락이므로 누구나 읽기 가능
      allow read: if true;

      // 2. 생성:
      // - 교사는 자유롭게 생성 가능
      // - 학생은 본인 uid로 된 메모만 생성 가능 (자기 것만 생성)
      // - 공통: 5자 이상 50자 이하, 필수 필드 형식 검증
      allow create: if (
          isTeacher() ||
          (isStudent() && request.resource.data.uid == request.auth.uid)
        )
        && request.resource.data.keys().hasAll(['text', 'createdAt'])
        && request.resource.data.keys().hasOnly(['text', 'createdAt', 'uid', 'aiComment'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5
        && request.resource.data.text.size() <= 50
        && (
          (request.resource.data.createdAt is timestamp && request.resource.data.createdAt == request.time)
          || request.resource.data.createdAt is int
          || request.resource.data.createdAt is number
        );

      // 3. 수정: 교사만 가능 (다른 사람은 건들지 못함)
      allow update: if isTeacher();

      // 4. 삭제:
      // - 교사는 모든 메모 삭제 가능 (관리 권한)
      // - 학생은 본인이 작성한 메모만 삭제 가능 (다른 사람 것은 건들지 못함)
      allow delete: if isTeacher() || (
        request.auth != null && resource.data.uid == request.auth.uid
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

