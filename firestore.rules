rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /memos/{memoId} {
      // 읽기와 삭제 허용
      allow read, delete: if true;

      // 메모를 저장할 때:
      // 1) text, createdAt 필드만 허용
      // 2) text는 문자열이고 5글자 이상, 50글자 이하
      // 3) createdAt은 timestamp 또는 숫자(밀리초)
      allow create: if request.resource.data.keys().hasOnly(['text', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5
        && request.resource.data.text.size() <= 50
        && (
          (request.resource.data.createdAt is timestamp && request.resource.data.createdAt == request.time)
          || request.resource.data.createdAt is int
          || request.resource.data.createdAt is number
        );

      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
